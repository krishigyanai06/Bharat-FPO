# Environment Variables for Bharat FPO Admin Dashboard
# Copy this file to .env.local for local development

# API Base URL
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=https://bharat-fpo.krishigyanai.com

# Default Tenant Code (MAR4UP for Marjeevi Pragatisheel FPO)
VITE_TENANT_CODE=MAR4UP

# PWA Configuration
VITE_PWA_THEME_COLOR=#16a34a
VITE_PWA_BACKGROUND_COLOR=#ffffff